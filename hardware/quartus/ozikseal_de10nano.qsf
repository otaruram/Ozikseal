# ============================================================================
# OzikSeal — Intel Quartus Prime Settings File
# ============================================================================
# Target Board:  Intel/Terasic DE10-Nano (Cyclone V SE 5CSEBA6U23I7)
# Purpose:       Pin assignments and project configuration for synthesis
#
# Pin Mapping Reference (DE10-Nano User Manual):
#   CLOCK_50  → PIN_V11   (50 MHz oscillator on the board)
#   KEY[0]    → PIN_AH17  (Push button — active-low reset)
#   GPIO_0[0] → PIN_AG13  (UART RX — from USB-UART adapter)
#   GPIO_0[1] → PIN_AF13  (UART TX — to USB-UART adapter)
#
# Usage:
#   Open this file in Intel Quartus Prime Lite Edition:
#   File → Open Project → Select this .qsf file
#   Then: Processing → Start Compilation
#
# Author: OzikSeal Team
# ============================================================================

# -----------------------------------------------------------------------
# Project Configuration
# -----------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY OzikSeal_Top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "22.1"
set_global_assignment -name LAST_QUARTUS_VERSION "22.1"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# -----------------------------------------------------------------------
# HDL Source Files
# -----------------------------------------------------------------------
set_global_assignment -name VERILOG_FILE ../rtl/OzikSeal_Top.v
set_global_assignment -name VERILOG_FILE ../rtl/uart_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/uart_tx.v

# -----------------------------------------------------------------------
# Pin Assignments — DE10-Nano Board
# -----------------------------------------------------------------------

# 50 MHz System Clock
set_location_assignment PIN_V11 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# Active-Low Reset Button (KEY[0])
set_location_assignment PIN_AH17 -to KEY_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY_N

# UART RX (GPIO_0[0] — connect to USB-UART adapter TX pin)
set_location_assignment PIN_AG13 -to UART_RX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RX

# UART TX (GPIO_0[1] — connect to USB-UART adapter RX pin)
set_location_assignment PIN_AF13 -to UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TX

# -----------------------------------------------------------------------
# Timing Constraints
# -----------------------------------------------------------------------
set_global_assignment -name SDC_FILE ozikseal_timing.sdc

# -----------------------------------------------------------------------
# Compilation Settings
# -----------------------------------------------------------------------
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
